# Third-party artifacts that bundle-wine.sh downloads and installs. One URL
# and one SHA-256 per artifact; the checksum is what validates a cached copy,
# so bumping a version means changing both lines. Sourced by bundle-wine.sh,
# hashed by the release workflow as its cache key.

# Apple's Game Porting Toolkit, the unmodified dmg. Apple's own download needs
# an Apple ID session, which nothing unattended can produce, so the image is
# mirrored as a release asset on this repository. A bump means downloading the
# new image by hand, attaching it to a new gptk-<version> release here, and
# repointing this URL.
GPTK_URL=https://github.com/athei/wine-build/releases/download/gptk-4.0-beta-2/Evaluation_environment_for_Windows_games_4.0_beta_2.dmg
GPTK_SHA256=6248a0edc61553790753e5e9c060b8e53c940ed197f11409dcc34a35e05becc1

DXMT_URL=https://github.com/3Shain/dxmt/releases/download/v0.80/dxmt-v0.80-builtin.tar.gz
DXMT_SHA256=8f260e36b5739e68f3bad613381441385c4dc7b85b78ba8de653d5a6a264529d

MTLD3D_URL=https://github.com/athei/mtld3d/releases/download/v0.7.0/mtld3d.tar.xz
MTLD3D_SHA256=e4ad62c2c22389fd9c4aab228cbb3e4b2298d4ff6a19de1de528c2aceb324409

# x87sidecar runs i386 processes under Rosetta with faster x87 floating-point.
# The archive holds only the ad-hoc signed arm64 binary, so its license comes
# from the same tag of the source repository and is pinned on its own.
X87SIDECAR_URL=https://github.com/athei/x87sidecar/releases/download/v1.8.0/x87sidecar.tar.xz
X87SIDECAR_SHA256=f2548854f24818e3755e327097f31479e1ffd71c39ee432003d3ea4053528173
X87SIDECAR_LICENSE_URL=https://raw.githubusercontent.com/athei/x87sidecar/v1.8.0/LICENSE
X87SIDECAR_LICENSE_SHA256=b0c3f8090dbc91b3583d826944ac0570483a42407d7008c9746f943578e5d9cd
